{
  "name": "@duke-dsh-plugins/dsh-token-stats",
  "version": "1.11.0",
  "description": "Token usage statistics for DeepSeek Harness (7/30-day per-model charts + yearly heatmap) plus an inline coding-plan balance/quota readout in the composer (minimax/deepseek/kimi/openrouter/zhipu/mimo/opencode-go/bailian; mimo uses the dashboard cookie since MiMo exposes no API-key quota API; bailian Token Plan uses AK/SK -> CLI access token -> console gateway, configurable in the settings page when a qwen token plan model is set up).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-token-stats.git"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-token-stats",
  "bugs": {
    "url": "https://github.com/MoonlitDropOfBlood/dsh-token-stats/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "stats"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bailian-quota.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "icon.svg",
    "scripts/probe-bailian.mjs",
    "scripts/bailian-workspace-init.mjs",
    "scripts/smoke-bailian.mjs"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.4-rc.2 <0.3.0 || ^0.2.1-rc.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.4-rc.2 <0.3.0 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check bailian-quota.js && node --check client.js && node --check typert.host.js",
    "smoke": "node scripts/smoke-store.mjs",
    "smoke:quota": "node scripts/smoke-quota.mjs",
    "smoke:bailian": "node scripts/smoke-bailian.mjs",
    "smoke:robust": "node scripts/smoke-robust-host.mjs && node scripts/smoke-robust-client.mjs",
    "smoke:navicon": "node scripts/smoke-settings-nav-icon.mjs",
    "smoke:typert": "node scripts/smoke-typert.mjs",
    "smoke:compat": "node scripts/smoke-compat.mjs",
    "probe:mimo": "node scripts/probe-mimo.mjs",
    "probe:mimo:nocookie": "node scripts/probe-mimo-nocookie.mjs",
    "probe:mimo:session": "node scripts/probe-mimo-session.mjs",
    "probe:bailian": "node scripts/probe-bailian.mjs",
    "fix:bailian-workspace": "node scripts/bailian-workspace-init.mjs",
    "e2e": "npm run check && npm run smoke && npm run smoke:quota && npm run smoke:bailian && npm run smoke:robust && npm run smoke:navicon && npm run smoke:typert && npm run smoke:compat && node scripts/repro-client-mount.mjs && node scripts/repro-strict-dispatch.mjs && node scripts/repro-profile-boot.mjs"
  }
}
